{
  "name": "chiefmotto-app",
  "version": "1.0.0",
  "description": "ChiefMotto - 简洁的座右铭桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": ["motto", "desktop", "widget", "chiefmotto"],
  "author": "Andy",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.andy.chiefmotto",
    "productName": "ChiefMotto",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "app.js",
      "i18n-init.js",
      "themes.css",
      "tray-icon.png",
      "tray-icon@2x.png",
      "tray-icon-Template.png",
      "tray-icon-Template@2x.png",
      "package.json"
    ]
  }
}
