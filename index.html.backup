<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChiefMotto</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      -webkit-app-region: drag;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
      overflow: hidden;
      background: transparent;
      cursor: move;
    }

    .container {
      padding: 20px 30px 25px 30px;
      border-radius: 12px;
      position: relative;
      min-width: 200px;
      max-width: 600px;

      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(30px) saturate(200%);
      -webkit-backdrop-filter: blur(30px) saturate(200%);

      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow:
        0 8px 32px 0 rgba(0, 0, 0, 0.25),
        inset 0 1px 0 0 rgba(255, 255, 255, 0.3);

      color: rgba(255, 255, 255, 0.98);
      font-size: 18px;
      font-weight: 500;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);

      animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 1;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(-10px) scale(0.95);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (prefers-color-scheme: dark) {
      .container {
        background: rgba(30, 30, 30, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.15);
      }
    }

    .motto-text {
      user-select: none;
      letter-spacing: 0.5px;
      line-height: 1.6;
      word-wrap: break-word;
      max-width: 540px;
    }

    .close-btn {
      -webkit-app-region: no-drag;
      position: absolute;
      top: 6px;
      right: 6px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(255, 59, 48, 0.85);
      border: none;
      cursor: pointer;
      opacity: 0;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 14px;
      line-height: 1;
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(255, 59, 48, 0.3);
    }

    .container:hover .close-btn {
      opacity: 1;
    }

    .close-btn:hover {
      background: rgba(255, 59, 48, 1);
      transform: scale(1.1);
      box-shadow: 0 4px 12px rgba(255, 59, 48, 0.5);
    }

    .close-btn:active {
      transform: scale(0.95);
    }

    .modal {
      -webkit-app-region: no-drag;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(10px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .modal.show {
      display: flex;
      animation: modalFadeIn 0.2s ease forwards;
    }

    @keyframes modalFadeIn {
      to { opacity: 1; }
    }

    .modal-content {
      background: rgba(255, 255, 255, 0.95);
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      text-align: center;
      color: #333;
      min-width: 350px;
      max-width: 500px;
      transform: scale(0.9);
      animation: contentPopIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      position: relative;
    }

    @keyframes contentPopIn {
      to {
        transform: scale(1);
      }
    }

    @media (prefers-color-scheme: dark) {
      .modal-content {
        background: rgba(40, 40, 40, 0.95);
        color: #fff;
      }
    }

    .modal-close-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.1);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #666;
      font-size: 18px;
      line-height: 1;
      transition: all 0.2s;
    }

    @media (prefers-color-scheme: dark) {
      .modal-close-btn {
        background: rgba(255, 255, 255, 0.1);
        color: #aaa;
      }
    }

    .modal-close-btn:hover {
      background: rgba(0, 0, 0, 0.15);
      transform: scale(1.1);
    }

    @media (prefers-color-scheme: dark) {
      .modal-close-btn:hover {
        background: rgba(255, 255, 255, 0.15);
      }
    }

    .modal-close-btn:active {
      transform: scale(0.9);
    }

    .modal-content h2 {
      font-size: 24px;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .modal-content p {
      font-size: 14px;
      color: #666;
      margin: 5px 0;
    }

    @media (prefers-color-scheme: dark) {
      .modal-content p {
        color: #aaa;
      }
    }

    .about-motto {
      margin-top: 15px;
      font-size: 16px;
      color: #333 !important;
    }

    @media (prefers-color-scheme: dark) {
      .about-motto {
        color: #fff !important;
      }
    }

    .edit-input-wrapper {
      position: relative;
      margin: 20px 0 30px 0;
    }

    .edit-input {
      width: 100%;
      padding: 14px 16px;
      min-height: 48px;
      border: 2px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
      transition: all 0.2s;
      background: white;
      color: #333;
    }

    @media (prefers-color-scheme: dark) {
      .edit-input {
        background: rgba(60, 60, 60, 0.8);
        border-color: #555;
        color: #fff;
      }
    }

    .edit-input:focus {
      outline: none;
      border-color: #007AFF;
      box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.1);
    }

    .edit-input.error {
      border-color: #FF3B30;
      animation: shake 0.3s;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    .char-counter {
      position: absolute;
      right: 12px;
      bottom: -24px;
      font-size: 12px;
      color: #999;
      transition: color 0.2s;
      background: rgba(255, 255, 255, 0.9);
      padding: 2px 6px;
      border-radius: 4px;
    }

    @media (prefers-color-scheme: dark) {
      .char-counter {
        background: rgba(40, 40, 40, 0.9);
      }
    }

    .char-counter.warning {
      color: #FF9500;
    }

    .char-counter.error {
      color: #FF3B30;
      font-weight: 600;
    }

    .edit-hint {
      font-size: 13px;
      color: #666;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    @media (prefers-color-scheme: dark) {
      .edit-hint {
        color: #aaa;
      }
    }

    .keyboard-hint {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      color: #999;
      margin-top: 8px;
    }

    .key {
      display: inline-block;
      padding: 2px 6px;
      background: #f0f0f0;
      border-radius: 4px;
      font-family: monospace;
      font-size: 10px;
      border: 1px solid #ddd;
    }

    @media (prefers-color-scheme: dark) {
      .key {
        background: #555;
        border-color: #666;
        color: #fff;
      }
    }

    .edit-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 30px;
    }

    .btn {
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s;
      position: relative;
      overflow: hidden;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }

    .btn-primary {
      background: #007AFF;
      color: white;
    }

    .btn-primary:not(:disabled):hover {
      background: #0051D5;
      transform: scale(1.05);
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
    }

    .btn-primary.loading {
      pointer-events: none;
    }

    .btn-primary.loading::after {
      content: '';
      position: absolute;
      width: 16px;
      height: 16px;
      top: 50%;
      left: 50%;
      margin-left: -8px;
      margin-top: -8px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .btn-primary.loading span {
      opacity: 0;
    }

    .btn-secondary {
      background: #e0e0e0;
      color: #333;
    }

    @media (prefers-color-scheme: dark) {
      .btn-secondary {
        background: #555;
        color: #fff;
      }
    }

    .btn-secondary:not(:disabled):hover {
      background: #d0d0d0;
      transform: scale(1.05);
    }

    @media (prefers-color-scheme: dark) {
      .btn-secondary:not(:disabled):hover {
        background: #666;
      }
    }

    .btn:active:not(:disabled) {
      transform: scale(0.95);
    }

    .toast {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.8);
      background: rgba(0, 0, 0, 0.85);
      color: white;
      padding: 16px 28px;
      border-radius: 12px;
      font-size: 15px;
      z-index: 2000;
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      backdrop-filter: blur(10px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
      max-width: 300px;
      text-align: center;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .toast.success {
      background: rgba(52, 199, 89, 0.95);
    }

    .toast.error {
      background: rgba(255, 59, 48, 0.95);
    }

    .toast.warning {
      background: rgba(255, 149, 0, 0.95);
    }

    .hint {
      position: absolute;
      bottom: 5px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      color: rgba(255, 255, 255, 0.5);
      opacity: 0;
      transition: opacity 0.3s;
      white-space: nowrap;
      pointer-events: none;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    .container:hover .hint {
      opacity: 1;
    }

    .modal-hint {
      margin-top: 15px;
      font-size: 11px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="container">
    <button class="close-btn" id="closeBtn" title="退出 (Cmd+Q)">×</button>
    <div class="motto-text" id="mottoText">加载中...</div>
    <div class="hint">右键编辑或查看更多</div>
  </div>

  <div class="toast" id="toast"></div>

  <div class="modal" id="editModal">
    <div class="modal-content">
      <button class="modal-close-btn" id="editModalCloseBtn">×</button>
      <h2>编辑座右铭</h2>
      <p class="edit-hint">
        <span>最多 50 个字符</span>
      </p>
      <div class="edit-input-wrapper">
        <input
          type="text"
          class="edit-input"
          id="mottoInput"
          placeholder="请输入你的座右铭"
          maxlength="50"
          autocomplete="off"
          spellcheck="false"
        >
        <div class="char-counter" id="charCounter">0 / 50</div>
      </div>
      <div class="keyboard-hint">
        <span class="key">↵</span> 保存
        <span style="margin-left: 8px;"><span class="key">Esc</span> 取消</span>
      </div>
      <div class="edit-buttons">
        <button class="btn btn-primary" id="editSaveBtn">
          <span>保存</span>
        </button>
        <button class="btn btn-secondary" id="editCancelBtn">取消</button>
      </div>
    </div>
  </div>

  <div class="modal" id="aboutModal">
    <div class="modal-content">
      <button class="modal-close-btn" id="aboutModalCloseBtn">×</button>
      <h2>ChiefMotto</h2>
      <p>版本 1.0.0</p>
      <p class="about-motto" id="aboutMottoText">对抗熵增，不加一事</p>
      <p style="margin-top: 10px; font-size: 12px;">一个简洁的桌面座右铭应用</p>
      <p class="modal-hint">按 <span class="key">Esc</span> 关闭</p>
      <button class="btn btn-primary" id="aboutCloseBtn" style="margin-top: 20px;">关闭</button>
    </div>
  </div>

  <script>
    let currentMotto = '';
    let isAnimationComplete = false;

    setTimeout(() => {
      isAnimationComplete = true;
    }, 400);

    function showToast(message, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = `toast ${type}`;

      void toast.offsetWidth;

      toast.classList.add('show');

      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }

    async function loadMotto() {
      if (window.electronAPI && window.electronAPI.getMotto) {
        try {
          currentMotto = await window.electronAPI.getMotto();
          document.getElementById('mottoText').textContent = currentMotto;
          document.getElementById('aboutMottoText').textContent = currentMotto;

          document.fonts.ready.then(() => {
            adjustWindowSize();
          });
        } catch (err) {
          console.error('Failed to load motto:', err);
          showToast('加载座右铭失败', 'error');
        }
      }
    }

    loadMotto();

    function adjustWindowSize() {
      const text = document.querySelector('.motto-text');

      requestAnimationFrame(() => {
        const textWidth = text.offsetWidth;
        const textHeight = text.offsetHeight;

        const windowWidth = Math.min(Math.max(textWidth + 60, 200), 600);
        const windowHeight = textHeight + 45;

        if (window.electronAPI && window.electronAPI.resizeWindow) {
          window.electronAPI.resizeWindow({
            width: Math.ceil(windowWidth),
            height: Math.ceil(windowHeight)
          });
        }
      });
    }

    document.getElementById('closeBtn').addEventListener('click', function(e) {
      const btn = e.currentTarget;
      btn.style.transform = 'scale(0.8)';

      setTimeout(() => {
        if (window.electronAPI && window.electronAPI.quitApp) {
          window.electronAPI.quitApp();
        } else {
          btn.style.transform = '';
          console.error('electronAPI not available');
          showToast('无法退出应用，请使用 Cmd+Q', 'error');
        }
      }, 150);
    });

    function showEdit() {
      if (!isAnimationComplete) {
        setTimeout(showEdit, 100);
        return;
      }

      const modal = document.getElementById('editModal');
      const input = document.getElementById('mottoInput');
      input.value = currentMotto;
      updateCharCounter();
      modal.classList.add('show');

      setTimeout(() => {
        input.focus();
        input.select();
      }, 200);
    }

    function closeEdit() {
      const modal = document.getElementById('editModal');
      const input = document.getElementById('mottoInput');

      modal.classList.remove('show');

      setTimeout(() => {
        input.value = currentMotto;
        input.classList.remove('error');
        updateCharCounter();
        document.getElementById('editSaveBtn').disabled = false;
        document.getElementById('editSaveBtn').classList.remove('loading');
      }, 200);
    }

    function updateCharCounter() {
      const input = document.getElementById('mottoInput');
      const counter = document.getElementById('charCounter');
      const saveBtn = document.getElementById('editSaveBtn');
      const length = input.value.length;

      counter.textContent = `${length} / 50`;

      counter.classList.remove('warning', 'error');
      if (length > 45) {
        counter.classList.add('warning');
      }
      if (length > 50) {
        counter.classList.add('error');
      }

      saveBtn.disabled = length === 0 || length > 50;
    }

    async function saveMotto() {
      const input = document.getElementById('mottoInput');
      const saveBtn = document.getElementById('editSaveBtn');
      const newMotto = input.value.trim();

      if (!newMotto) {
        input.classList.add('error');
        showToast('座右铭不能为空', 'warning');
        setTimeout(() => input.classList.remove('error'), 300);
        return;
      }

      if (newMotto.length > 50) {
        input.classList.add('error');
        showToast('座右铭不能超过 50 个字符', 'warning');
        setTimeout(() => input.classList.remove('error'), 300);
        return;
      }

      if (newMotto === currentMotto) {
        closeEdit();
        return;
      }

      saveBtn.disabled = true;
      saveBtn.classList.add('loading');

      try {
        if (window.electronAPI && window.electronAPI.saveMotto) {
          const result = await window.electronAPI.saveMotto(newMotto);

          if (result && result.success) {
            currentMotto = newMotto;
            document.getElementById('mottoText').textContent = currentMotto;
            document.getElementById('aboutMottoText').textContent = currentMotto;

            closeEdit();
            showToast('保存成功', 'success');

            setTimeout(() => {
              adjustWindowSize();
            }, 50);
          } else {
            throw new Error(result?.error || '保存失败');
          }
        }
      } catch (err) {
        console.error('Failed to save motto:', err);
        showToast('保存失败，请重试', 'error');
        saveBtn.disabled = false;
        saveBtn.classList.remove('loading');
      }
    }

    document.getElementById('mottoInput').addEventListener('input', updateCharCounter);
    document.getElementById('editCancelBtn').addEventListener('click', closeEdit);
    document.getElementById('editSaveBtn').addEventListener('click', saveMotto);
    document.getElementById('editModalCloseBtn').addEventListener('click', closeEdit);

    document.getElementById('mottoInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !document.getElementById('editSaveBtn').disabled) {
        saveMotto();
      } else if (e.key === 'Escape') {
        closeEdit();
      }
    });

    function showAbout() {
      if (!isAnimationComplete) {
        setTimeout(showAbout, 100);
        return;
      }
      document.getElementById('aboutModal').classList.add('show');
    }

    function closeAbout() {
      document.getElementById('aboutModal').classList.remove('show');
    }

    document.getElementById('aboutCloseBtn').addEventListener('click', closeAbout);
    document.getElementById('aboutModalCloseBtn').addEventListener('click', closeAbout);

    if (window.electronAPI) {
      if (window.electronAPI.onShowAbout) {
        window.electronAPI.onShowAbout(() => {
          showAbout();
        });
      }

      if (window.electronAPI.onShowEdit) {
        window.electronAPI.onShowEdit(() => {
          showEdit();
        });
      }
    }

    document.getElementById('editModal').addEventListener('click', (e) => {
      if (e.target.id === 'editModal') {
        closeEdit();
      }
    });

    document.getElementById('aboutModal').addEventListener('click', (e) => {
      if (e.target.id === 'aboutModal') {
        closeAbout();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeEdit();
        closeAbout();
      }
    });
  </script>
</body>
</html>
